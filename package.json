{
	"name": "workspace",
	"private": true,
	"packageManager": "pnpm@12.18.0",
	"scripts": {
		"build": "turbo run build",
		"dev": "turbo run dev",
		"start": "turbo run start",
		"clean": "git clean -xdf node_modules .turbo",
		"clean:workspaces": "turbo run clean",
		"check": "biome check .",
		"fix": "biome check --write .",
		"db:generate": "turbo run db:generate --filter=@workspace/db",
		"db:migrate": "turbo run db:migrate --filter=@workspace/db",
		"db:studio": "turbo run db:studio --filter=@workspace/db"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.5",
		"prettier": "^3.9.10",
		"shadcn": "^4.23.0",
		"turbo": "^2.11.10",
		"typescript": "7"
	},
	"workspaces": [
		"apps/*",
		"packages/*"
	]
}
